{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/experience-log/weekly-summary.schema.json",
  "title": "Experience Weekly Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary_id", "type", "instance_id", "week", "period_start", "period_end", "daily_log_ids", "highlights", "progress", "blockers", "learnings", "next_week", "source_refs", "created_at", "schema_version"],
  "properties": {
    "summary_id": { "type": "string", "pattern": "^WEEK-\\d{4}-W\\d{2}$" },
    "type": { "const": "experience-weekly-summary" },
    "instance_id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/instanceId" },
    "week": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "period_start": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDate" },
    "period_end": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDate" },
    "daily_log_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^DAY-\\d{4}-\\d{2}-\\d{2}$" } },
    "highlights": { "type": "array", "items": { "type": "string" } },
    "progress": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "next_week": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath" } },
    "created_at": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime" },
    "schema_version": { "const": 1 },
    "_ownership": { "type": "object" }
  }
}
