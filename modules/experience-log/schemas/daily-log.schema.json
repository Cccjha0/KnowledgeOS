{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/experience-log/daily-log.schema.json",
  "title": "Experience Daily Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["daily_id", "type", "instance_id", "date", "entry_ids", "accomplishments", "blockers", "learnings", "next_actions", "source_refs", "created_at", "schema_version"],
  "properties": {
    "daily_id": { "type": "string", "pattern": "^DAY-\\d{4}-\\d{2}-\\d{2}$" },
    "type": { "const": "experience-daily-log" },
    "instance_id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/instanceId" },
    "date": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDate" },
    "entry_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EXP-\\d{4}-\\d{6,}$" } },
    "accomplishments": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "learnings": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath" } },
    "created_at": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime" },
    "schema_version": { "const": 1 },
    "_ownership": { "type": "object" },
    "generation": { "type": "object" }
  }
}
