{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/dashboard-item.schema.json",
  "title": "PKB Dashboard Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "source_module",
    "instance_id",
    "category",
    "priority",
    "title",
    "description",
    "target",
    "due_at",
    "actions"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^DSH-[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_module": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId"
    },
    "instance_id": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/instanceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "action",
        "review",
        "research",
        "summary",
        "deadline",
        "warning",
        "status",
        "system"
      ]
    },
    "priority": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/priority"
    },
    "title": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "due_at": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "open",
          "approve",
          "reject",
          "defer",
          "discuss",
          "generate",
          "run",
          "dismiss",
          "reconcile",
          "retry"
        ]
      }
    }
  }
}
