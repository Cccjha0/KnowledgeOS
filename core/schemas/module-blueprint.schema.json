{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/module-blueprint.schema.json",
  "title": "KnowledgeOS Module Blueprint v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint_version", "base_template", "capability_packs", "module", "module_class", "use_cases", "entities", "inputs", "outputs", "inbox", "privacy", "workflows", "review_policy", "jobs", "events", "dashboard", "testing"],
  "properties": {
    "blueprint_version": { "oneOf": [{ "const": 1 }, { "const": 1.1 }] },
    "base_template": { "enum": ["minimal-config", "standard-workflow", "integration"] },
    "capability_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "description", "intended_users"],
      "properties": {
        "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
        "display_name": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" },
        "description": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" },
        "intended_users": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } }
      }
    },
    "module_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "complexity"],
      "properties": {
        "type": { "enum": ["configuration", "workflow", "integration"] },
        "complexity": { "enum": ["minimal", "standard", "advanced"] }
      }
    },
    "use_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "excluded"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } },
        "excluded": { "type": "array", "minItems": 1, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownership"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "ownership": { "enum": ["module", "instance", "external"] },
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fields"],
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "enum": ["string", "number", "integer", "boolean", "datetime", "date", "enum", "array", "object", "reference"] },
                    "required": { "type": "boolean", "default": false },
                    "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                    "items": { "type": "string" },
                    "critical": { "type": "boolean", "default": false },
                    "provenance_required": { "type": "boolean", "default": false },
                    "freshness_days": { "type": "integer", "minimum": 1 },
                    "description": { "type": "string" }
                  }
                }
              },
              "template": { "type": "string", "minLength": 1 }
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["initial", "transitions"],
            "properties": {
              "initial": { "type": "string", "minLength": 1 },
              "transitions": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
            }
          },
          "relations": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } }
        }
      }
    },
    "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["markdown", "text", "json", "yaml", "pdf", "pptx", "docx", "image", "archive", "email"] } },
    "outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "entity", "schema", "template", "target"],
            "properties": {
              "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
              "entity": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
              "schema": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
              "template": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "inbox": {
      "type": "object", "additionalProperties": false,
      "required": ["module_level", "instance_level", "global_routing"],
      "properties": { "module_level": { "type": "boolean" }, "instance_level": { "type": "boolean" }, "global_routing": { "type": "boolean" } }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["default_sensitivity_class", "default_max_representation", "network_allowed", "user_original_content_mutable"],
      "properties": {
        "default_sensitivity_class": { "type": "integer", "minimum": 0, "maximum": 3 },
        "default_max_representation": { "enum": ["metadata", "summary", "full", "sensitive-original"] },
        "network_allowed": { "type": "boolean" },
        "user_original_content_mutable": { "type": "boolean" },
        "input_roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["sensitivity_class", "max_representation"],
            "properties": {
              "sensitivity_class": { "type": "integer", "minimum": 0, "maximum": 3 },
              "max_representation": { "enum": ["metadata", "summary", "full", "sensitive-original"] },
              "allow_codex": { "type": "boolean", "default": true }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "trigger", "requires_ai"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "trigger": { "enum": ["capture", "manual", "schedule", "field-due", "event", "startup"] },
          "requires_ai": { "type": "boolean" },
          "requires_network": { "type": "boolean", "default": false },
          "input_entities": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } },
          "input_roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entity", "window", "date_field"],
              "properties": {
                "entity": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
                "root": { "type": "string", "minLength": 1 },
                "window": { "enum": ["current-day", "current-week", "active-or-upcoming", "all"] },
                "date_field": { "type": "string", "minLength": 1 },
                "filters": { "type": "object" }
              }
            }
          },
          "output_entity": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "read": { "type": "object", "additionalProperties": false, "required": ["representation"], "properties": { "representation": { "enum": ["metadata", "summary", "full", "sensitive-original"] } } },
          "prompt": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } } },
          "operation": { "type": "object", "additionalProperties": false, "required": ["type", "target", "template"], "properties": { "type": { "enum": ["create-record", "update-record", "append-record"] }, "target": { "type": "string", "minLength": 1 }, "template": { "type": "string", "minLength": 1 } } },
          "review_when": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "condition"], "properties": { "field": { "type": "string", "minLength": 1 }, "condition": { "enum": ["missing", "conflicting", "missing-or-conflicting", "always"] } } } },
          "publishes": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["event"], "properties": { "event": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, "payload": { "type": "object" } } } }
        }
      }
    },
    "review_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["critical_fields", "ambiguous_input", "destructive_operations"],
      "properties": {
        "critical_fields": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } },
        "ambiguous_input": { "enum": ["review", "reject"] },
        "destructive_operations": { "enum": ["forbidden", "review-required"] }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "schedule", "catch_up"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "schedule": { "enum": ["daily", "weekly", "monthly", "field-due", "event", "startup"] },
          "catch_up": { "enum": ["none", "latest", "all", "aggregate", "skip-if-stale"] },
          "workflow_id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "timezone": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "scope": { "enum": ["instance", "module", "global"] },
          "retry": { "type": "object", "additionalProperties": false, "properties": { "max_attempts": { "type": "integer", "minimum": 0 }, "strategy": { "enum": ["exponential", "fixed"] } } },
          "concurrency": { "type": "object", "additionalProperties": false, "properties": { "policy": { "enum": ["allow", "forbid", "replace", "merge"] }, "key": { "type": "string" } } },
          "max_age_days": { "type": "integer", "minimum": 1 },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } }
        }
      }
    },
    "events": {
      "type": "object", "additionalProperties": false,
      "required": ["publishes", "subscribes"],
      "properties": {
        "publishes": { "type": "array", "uniqueItems": true, "items": { "oneOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, { "type": "object", "additionalProperties": false, "required": ["event"], "properties": { "event": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } } }] } },
        "subscribes": { "type": "array", "uniqueItems": true, "items": { "oneOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, { "type": "object", "additionalProperties": false, "required": ["event", "scope", "workflow_id"], "properties": { "event": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, "scope": { "enum": ["instance", "module", "global"] }, "source_modules": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } }, "workflow_id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } } }] } }
      }
    },
    "dashboard": {
      "type": "object", "additionalProperties": false, "required": ["sections"],
      "properties": { "sections": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } } }
    },
    "testing": {
      "type": "object", "additionalProperties": false,
      "required": ["normal_input", "ambiguous_input", "repeat_execution", "permission_denied", "paused_instance", "archived_instance", "prompt_regression"],
      "properties": {
        "normal_input": { "const": "required" }, "ambiguous_input": { "const": "required" }, "repeat_execution": { "const": "required" },
        "permission_denied": { "const": "required" }, "paused_instance": { "const": "required" }, "archived_instance": { "const": "required" },
        "prompt_regression": { "const": "required" }, "periodic_job": { "enum": ["required", "not-applicable"] },
        "event_publication": { "enum": ["required", "not-applicable"] }, "event_consumption": { "enum": ["required", "not-applicable"] },
        "migration": { "enum": ["required", "not-applicable"] }, "attachment_policy": { "enum": ["required", "not-applicable"] }
      }
    }
  }
}
