{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/module-blueprint.schema.json",
  "title": "KnowledgeOS Module Blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint_version", "base_template", "capability_packs", "module", "module_class", "use_cases", "entities", "inputs", "outputs", "inbox", "privacy", "workflows", "review_policy", "jobs", "events", "dashboard", "testing"],
  "properties": {
    "blueprint_version": { "const": 1 },
    "base_template": { "enum": ["minimal-config", "standard-workflow", "integration"] },
    "capability_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "description", "intended_users"],
      "properties": {
        "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
        "display_name": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" },
        "description": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" },
        "intended_users": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } }
      }
    },
    "module_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "complexity"],
      "properties": {
        "type": { "enum": ["configuration", "workflow", "integration"] },
        "complexity": { "enum": ["minimal", "standard", "advanced"] }
      }
    },
    "use_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "excluded"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } },
        "excluded": { "type": "array", "minItems": 1, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownership"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "ownership": { "enum": ["module", "instance", "external"] }
        }
      }
    },
    "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["markdown", "text", "json", "yaml", "pdf", "pptx", "docx", "image", "archive", "email"] } },
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } },
    "inbox": {
      "type": "object", "additionalProperties": false,
      "required": ["module_level", "instance_level", "global_routing"],
      "properties": { "module_level": { "type": "boolean" }, "instance_level": { "type": "boolean" }, "global_routing": { "type": "boolean" } }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["default_sensitivity_class", "default_max_representation", "network_allowed", "user_original_content_mutable"],
      "properties": {
        "default_sensitivity_class": { "type": "integer", "minimum": 0, "maximum": 3 },
        "default_max_representation": { "enum": ["metadata", "summary", "full", "sensitive-original"] },
        "network_allowed": { "type": "boolean" },
        "user_original_content_mutable": { "type": "boolean" }
      }
    },
    "workflows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "trigger", "requires_ai"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "trigger": { "enum": ["capture", "manual", "schedule", "field-due", "event", "startup"] },
          "requires_ai": { "type": "boolean" },
          "requires_network": { "type": "boolean", "default": false }
        }
      }
    },
    "review_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["critical_fields", "ambiguous_input", "destructive_operations"],
      "properties": {
        "critical_fields": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString" } },
        "ambiguous_input": { "enum": ["review", "reject"] },
        "destructive_operations": { "enum": ["forbidden", "review-required"] }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "schedule", "catch_up"],
        "properties": {
          "id": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" },
          "schedule": { "enum": ["daily", "weekly", "monthly", "field-due", "event", "startup"] },
          "catch_up": { "enum": ["none", "latest", "all", "aggregate", "skip-if-stale"] }
        }
      }
    },
    "events": {
      "type": "object", "additionalProperties": false,
      "required": ["publishes", "subscribes"],
      "properties": {
        "publishes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } },
        "subscribes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } }
      }
    },
    "dashboard": {
      "type": "object", "additionalProperties": false, "required": ["sections"],
      "properties": { "sections": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" } } }
    },
    "testing": {
      "type": "object", "additionalProperties": false,
      "required": ["normal_input", "ambiguous_input", "repeat_execution", "permission_denied", "paused_instance", "archived_instance", "prompt_regression"],
      "properties": {
        "normal_input": { "const": "required" }, "ambiguous_input": { "const": "required" }, "repeat_execution": { "const": "required" },
        "permission_denied": { "const": "required" }, "paused_instance": { "const": "required" }, "archived_instance": { "const": "required" },
        "prompt_regression": { "const": "required" }, "periodic_job": { "enum": ["required", "not-applicable"] },
        "event_publication": { "enum": ["required", "not-applicable"] }, "event_consumption": { "enum": ["required", "not-applicable"] },
        "migration": { "enum": ["required", "not-applicable"] }, "attachment_policy": { "enum": ["required", "not-applicable"] }
      }
    }
  }
}
