{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/module-manifest.schema.json",
  "title": "PKB Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "maturity",
    "status",
    "engine",
    "data",
    "module_type",
    "capabilities",
    "accepted_inputs",
    "inbox",
    "routing",
    "entry_workflows",
    "schemas",
    "prompts",
    "workflows",
    "jobs",
    "permissions"
  ],
  "properties": {
    "id": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId"
    },
    "name": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "maturity": {
      "type": "string",
      "enum": ["experimental", "beta", "stable", "deprecated"]
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "description": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "field_labels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
          }
        },
        "job_labels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "min_version",
        "max_version"
      ],
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "min_version": {
          "type": "string"
        },
        "max_version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 }
      }
    },
    "module_type": {
      "type": "string",
      "enum": [
        "configuration",
        "workflow",
        "integration"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "capture-processing",
          "metadata-enrichment",
          "file-organization",
          "attachment-management",
          "link-suggestion",
          "periodic-summary",
          "dashboard-items",
          "review-items",
          "event-publishing",
          "event-subscription",
          "research-request"
        ]
      }
    },
    "accepted_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "markdown",
          "text",
          "json",
          "yaml",
          "pdf",
          "pptx",
          "docx",
          "image",
          "archive",
          "email"
        ]
      }
    },
    "pdf_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["pending", "completed", "partial", "empty", "scanned", "encrypted", "corrupted", "unsupported", "failed"] }
        },
        "partial_policy": { "type": "string", "enum": ["allow", "review"] }
      }
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_level",
        "instance_level",
        "allow_global_routing"
      ],
      "properties": {
        "module_level": {
          "$ref": "#/$defs/inboxConfig"
        },
        "instance_level": {
          "$ref": "#/$defs/inboxConfig"
        },
        "allow_global_routing": {
          "type": "boolean"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcher",
        "auto_route_threshold",
        "review_threshold"
      ],
      "properties": {
        "matcher": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        },
        "auto_route_threshold": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/confidence"
        },
        "review_threshold": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/confidence"
        }
      }
    },
    "entry_workflows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath" }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath" }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "subscribes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "anyOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId" }
            },
            {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^(?:\\^|~)?\\d+\\.\\d+\\.\\d+$" }
            }
          ]
        }
      }
    },
    "scheduled_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "schedule",
          "workflow",
          "timezone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "schedule": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
          },
          "workflow": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
          },
          "timezone": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "codex",
        "delete",
        "cross_module_write"
      ],
      "properties": {
        "max_sensitivity_class": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/readLevel"
        },
        "max_read_level": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/readLevel"
        },
        "network": { "type": "boolean" },
        "codex": { "type": "string", "enum": ["required", "optional", "disabled"] },
        "delete": { "type": "boolean" },
        "cross_module_write": { "type": "boolean" },
        "max_default_read_level": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/readLevel"
        },
        "allow_external_network": {
          "type": "boolean"
        },
        "allow_delete": {
          "type": "boolean"
        },
        "allow_bulk_move": {
          "type": "boolean"
        }
      },
      "anyOf": [
        { "required": ["max_sensitivity_class"] },
        { "required": ["max_read_level"] }
      ]
    },
    "instance_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_root_pattern", "inbox_path_pattern", "fields"],
      "properties": {
        "content_root_pattern": { "type": "string", "minLength": 1 },
        "inbox_path_pattern": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "type", "required"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$" },
              "label": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["text", "date", "number", "select", "boolean", "timezone"] },
              "required": { "type": "boolean" },
              "default": {},
              "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": { "policy": { "type": "string", "pattern": "^rules/.+\\.ya?ml$" } }
    }
  },
  "$defs": {
    "inboxConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        },
        "path_pattern": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "path_pattern"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
