{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/module-manifest.schema.json",
  "title": "PKB Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "engine",
    "module_type",
    "capabilities",
    "accepted_inputs",
    "inbox",
    "routing",
    "entry_workflows",
    "schemas",
    "permissions"
  ],
  "properties": {
    "id": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId"
    },
    "name": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "description": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_version",
        "max_version"
      ],
      "properties": {
        "min_version": {
          "type": "string"
        },
        "max_version": {
          "type": "string"
        }
      }
    },
    "module_type": {
      "type": "string",
      "enum": [
        "configuration",
        "workflow",
        "integration"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "capture-processing",
          "metadata-enrichment",
          "file-organization",
          "attachment-management",
          "link-suggestion",
          "periodic-summary",
          "dashboard-items",
          "review-items",
          "event-publishing",
          "event-subscription",
          "research-request"
        ]
      }
    },
    "accepted_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "markdown",
          "text",
          "json",
          "yaml",
          "pdf",
          "pptx",
          "docx",
          "image",
          "archive",
          "email"
        ]
      }
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_level",
        "instance_level",
        "allow_global_routing"
      ],
      "properties": {
        "module_level": {
          "$ref": "#/$defs/inboxConfig"
        },
        "instance_level": {
          "$ref": "#/$defs/inboxConfig"
        },
        "allow_global_routing": {
          "type": "boolean"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcher",
        "auto_route_threshold",
        "review_threshold"
      ],
      "properties": {
        "matcher": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        },
        "auto_route_threshold": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/confidence"
        },
        "review_threshold": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/confidence"
        }
      }
    },
    "entry_workflows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "subscribes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId"
          }
        }
      }
    },
    "scheduled_jobs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_default_read_level",
        "allow_external_network",
        "allow_delete",
        "allow_bulk_move"
      ],
      "properties": {
        "max_default_read_level": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/readLevel"
        },
        "allow_external_network": {
          "type": "boolean"
        },
        "allow_delete": {
          "type": "boolean"
        },
        "allow_bulk_move": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "inboxConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
        },
        "path_pattern": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "path_pattern"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
