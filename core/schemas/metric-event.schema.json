{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/metric-event.schema.json",
  "title": "Metric Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_id", "idempotency_key", "event_type", "module", "instance_id", "workflow_id", "workflow_version", "prompt_id", "prompt_version", "run_id", "occurred_at", "dimensions", "values"],
  "properties": {
    "metric_id": { "type": "string", "pattern": "^MET-\\d{4}-\\d{6,}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string" },
    "module": { "type": "string" },
    "instance_id": { "type": ["string", "null"] },
    "workflow_id": { "type": ["string", "null"] },
    "workflow_version": { "type": ["string", "null"] },
    "prompt_id": { "type": ["string", "null"] },
    "prompt_version": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "occurred_at": { "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime" },
    "dimensions": { "type": "object" },
    "values": { "type": "object" }
  }
}
