{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkb.local/schemas/core/review-item.schema.json",
  "title": "PKB Review Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "schema_version",
    "source_module",
    "instance_id",
    "target",
    "action",
    "confidence",
    "priority",
    "status",
    "reason",
    "created",
    "decision",
    "decision_history",
    "target_observation"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^REV-\\d{4}-\\d{6,}$"
    },
    "origin_task_id": {
      "type": ["string", "null"],
      "pattern": "^TASK-\\d{4}-\\d{6,}$"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_module": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/moduleId"
    },
    "instance_id": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/instanceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/vaultPath"
    },
    "action": {
      "type": "string"
    },
    "proposed_value": {},
    "confidence": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/confidence"
    },
    "priority": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/priority"
    },
    "status": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/reviewStatus"
    },
    "reason": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/nonEmptyString"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime"
    },
    "review_after": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "https://pkb.local/schemas/core/review-decision.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_history": {
      "type": "array",
      "items": {
        "$ref": "https://pkb.local/schemas/core/review-decision.schema.json"
      }
    },
    "target_observation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "observed_value",
            "checked_at",
            "matches"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "observed_value": {},
            "checked_at": {
              "$ref": "https://pkb.local/schemas/core/common.schema.json#/$defs/isoDateTime"
            },
            "matches": {
              "type": "string",
              "enum": [
                "old",
                "proposed",
                "neither"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": { "type": ["object", "null"] },
    "review_fingerprint": { "type": "string", "minLength": 16 },
    "evidence_hash": { "type": "string", "minLength": 16 },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "occurrence_count": { "type": "integer", "minimum": 1 },
    "sla_due_at": { "type": "string", "format": "date-time" },
    "overdue": { "type": "boolean" },
    "suppressed_until": { "type": ["string", "null"], "format": "date-time" }
  }
}
