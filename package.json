{
  "name": "knowledgeos-engine",
  "version": "0.9.0-beta",
  "private": true,
  "type": "module",
  "bin": {
    "pkb": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugin": "esbuild plugins/knowledgeos-obsidian/main.js --bundle --platform=node --format=cjs --target=es2022 --external:obsidian --outfile=plugins/knowledgeos-obsidian/dist/main.js",
    "pack:plugin": "node tools/pack-obsidian-plugin.mjs",
    "check:boundaries": "python -X utf8 tools/check_core_boundaries.py",
    "prepare": "npm run build",
    "validate": "node dist/cli.js validate --vault ../knowledgeos-vault",
    "test": "npm run check:boundaries && npm run build && npm run test:engine",
    "test:engine": "node tools/run-engine-tests.mjs",
    "test:codex-isolation": "node --test dist/tests/codex-context.integration.test.js",
    "test:plugin-smoke": "node plugins/knowledgeos-obsidian/tests/core-command-client.smoke.test.cjs",
    "chain": "node dist/cli.js application process-report 20-Workspace/Applications/australia-masters-2027/Inbox/2026-07-27-Monash-C6007-Update.md --vault ../knowledgeos-vault"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  }
}
